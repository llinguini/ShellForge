{
  "name": "shellforge",
  "version": "0.1.3",
  "description": "A fast native terminal emulator for Linux and macOS.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:deb": "tauri build --bundles deb",
    "tauri:build:dmg": "tauri build --bundles dmg"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "2",
    "@xterm/addon-fit": "latest",
    "@xterm/xterm": "latest",
    "react": "18",
    "react-dom": "18"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "latest",
    "vite": "latest"
  },
  "keywords": [
    "terminal",
    "tauri",
    "pty"
